{
  "name": "keystroke-keep",
  "version": "0.1.0",
  "description": "A tiny dungeon crawler that lives in a strip at the bottom of your screen. Your work is their adventure.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "serve": "python tools/serve.py 5173",
    "sim": "node tools/sim.js 120 typist 60",
    "dist": "electron-builder --win dir",
    "dist:demo": "electron-builder --win dir --config.extraMetadata.kkDemo=true --config.extraMetadata.productName=\"Keystroke Keep Demo\" --config.productName=\"Keystroke Keep Demo\" --config.directories.output=dist/demo",
    "icon": "electron tools/make-icon.js"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "koffi": "^3.3.7",
    "uiohook-napi": "^1.5.5"
  },
  "productName": "Keystroke Keep",
  "author": "Keystroke Keep",
  "build": {
    "appId": "com.keystrokekeep.game",
    "productName": "Keystroke Keep",
    "directories": {
      "output": "dist/full",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "!node_modules/koffi/{doc,vendor}/**",
      "!node_modules/@koromix/*/**/*.lib",
      "!node_modules/uiohook-napi/{src,libuiohook}/**",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-*,win32-arm64}/**",
      "!node_modules/koffi/src/**/*.{cc,hh,c,h,cpp,S,asm,txt}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "signExts": [
        ".node"
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "copyright": "Copyright © 2026 Keystroke Keep"
  }
}
